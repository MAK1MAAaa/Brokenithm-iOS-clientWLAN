<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrokenithmLan</RootNamespace>
    <AssemblyName>Brokenithm-LAN</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodePage>65001</CodePage>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Compile Include="src\BridgeOptions.cs" />
    <Compile Include="src\AsyncConsoleLog.cs" />
    <Compile Include="src\ConnectionNotice.cs" />
    <Compile Include="src\DnsSd.cs" />
    <Compile Include="src\MdnsDiscovery.cs" />
    <Compile Include="src\LanBridge.cs" />
    <Compile Include="src\Program.cs" />
    <Compile Include="src\Protocol.cs" />
    <Compile Include="src\SharedMemoryState.cs" />
    <None Include="src\App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
